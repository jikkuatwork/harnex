<!doctype html>
<html><head><meta charset="utf-8"><style>
@font-face { font-family: "JetBrains Mono"; src: url(<%= font["Regular"] %>) format("woff2"); font-weight: 400; }
@font-face { font-family: "JetBrains Mono"; src: url(<%= font["Bold"] %>) format("woff2"); font-weight: 700; }
@font-face { font-family: "JetBrains Mono"; src: url(<%= font["ExtraBold"] %>) format("woff2"); font-weight: 800; }
* { box-sizing: border-box; margin: 0; }
html, body { width: <%= WIDTH %>px; height: <%= HEIGHT %>px; overflow: hidden; }
body {
  position: relative; color: #e6e2d6; font-family: "JetBrains Mono", monospace; -webkit-font-smoothing: antialiased;
  background: radial-gradient(900px 520px at 8% -10%, rgba(232, 163, 61, 0.20), transparent 70%), #0c0d0b;
}
.host { position: absolute; left: 76px; top: 56px; font-size: 22px; color: #9a968a; letter-spacing: 0.01em; }
.host b { color: #e8a33d; font-weight: 700; }
.text { position: absolute; left: 76px; top: 112px; bottom: 60px; width: 540px; display: flex; flex-direction: column; justify-content: center; }
.icon { width: 128px; height: 128px; border-radius: 30px; box-shadow: 0 18px 50px -18px rgba(232, 163, 61, 0.45); }
h1 { margin-top: 26px; display: flex; align-items: flex-end; font-size: 116px; font-weight: 800; line-height: 0.95; letter-spacing: -0.04em; }
h1 span { display: inline-block; width: 0.5em; height: 0.8em; margin: 0 0 0.06em 0.08em; background: #e8a33d; }
p { margin-top: 22px; font-size: 31px; line-height: 1.3; color: #e6e2d6; }
p em { font-style: normal; color: #e8a33d; }
.cmd { margin-top: 30px; align-self: flex-start; padding: 13px 24px; border: 2px solid #3a3d35; border-radius: 12px; background: #151713; font-size: 25px; }
.cmd b { color: #e8a33d; margin-right: 14px; }
.term { position: absolute; right: 64px; top: 70px; bottom: 0; width: 508px; overflow: hidden; border: 2px solid #3a3d35; border-bottom: 0; border-radius: 18px 18px 0 0; background: #121310; box-shadow: 0 0 0 1px rgba(232, 163, 61, 0.18), 0 -10px 80px -30px rgba(232, 163, 61, 0.5); }
.bar { display: flex; justify-content: space-between; padding: 14px 20px; border-bottom: 2px solid #2a2c26; font-size: 16px; color: #66635b; }
pre { padding: 18px 20px; font: 400 16.5px/1.55 "JetBrains Mono", monospace; white-space: pre-wrap; color: #9a968a; }
.p, .f { color: #e8a33d; }
.c { color: #e6e2d6; }
.ok { color: #a3d46c; }
.t { color: #74c7b8; }
.cur { display: inline-block; width: 0.6em; height: 1.1em; vertical-align: -0.2em; background: #e8a33d; }
</style></head><body>
<div class="host"><b>harnex</b>.zyt.app</div>
<div class="text">
  <img class="icon" src="<%= icon %>" alt="">
  <h1>harnex<span></span></h1>
  <p>Pi workers as tools for you and your <em>coding agents</em>.</p>
  <div class="cmd"><b>$</b>gem install harnex</div>
</div>
<div class="term">
  <div class="bar"><span>~/textkit — zsh</span><span>pi · gpt-5.1</span></div>
<pre><span class="p">$ </span><span class="c">harnex delegate --worktree word-count "Add TextKit.word_count(text) with a test; run bin/test."</span>

Committed as <span class="t">a6bf91e</span> on <span class="t">harnex/word-count</span>.
- Added TextKit.word_count(text).
- Ran bin/test: 3 tests, all passing.

<span class="f">── word-count: <span class="ok">done in 49s</span> · $0.03 · 1 commit</span>

<span class="p">$ </span><span class="c">harnex land word-count</span>
<span class="f">── word-count: merged harnex/word-count into main; removed its worktree and branch</span>

<span class="p">$ </span><span class="cur"></span></pre>
</div>
</body></html>
